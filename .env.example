# SSH-HoneyGuard — example environment file
# Copy to `.env` and adjust. `.env` itself must NEVER be committed (see .gitignore).
# No real credentials belong here — this file only configures the honeypot's
# own runtime behavior, not any external service.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Honeypot (Phase 3+) ---
HONEYPOT_HOST=0.0.0.0
HONEYPOT_PORT=2222

# --- Database (Phase 9) ---
DATABASE_URL=sqlite:///./data/honeyguard.db

# --- API backend (Phase 10) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard (Phase 11) ---
DASHBOARD_PORT=8501

# --- Detection thresholds (Phase 6-7; overridable defaults, see config/config.yaml) ---
BRUTE_FORCE_ATTEMPT_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=5
